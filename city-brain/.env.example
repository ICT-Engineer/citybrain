# City Brain configuration. Copy to brain/.env. Every partner address and secret comes from here, never from code.
PORT=8300
SIMULATOR=true                 # true = built-in Twin + Guardian simulators (R1). false = real partners.
MOCK_MODE=true
# --- Twin (twin-interface-0.1) ---
TWIN_URL=http://127.0.0.1:8310
TWIN_TRANSPORT=rest            # rest | mcp
TWIN_MCP_URL=http://127.0.0.1:8000/sse
TWIN_TOKEN_BRAIN=token-brain-secret-2026   # Twin's documented LOCAL-DEV token only; replace for any shared deployment
TWIN_POLL_INTERVAL_S=1.0
# --- Guardian (v0.4) ---
GUARDIAN_URL=http://127.0.0.1:8320
GUARDIAN_MODE=lookup           # lookup | push
GUARDIAN_TOKEN_BRAIN=
GUARDIAN_TIMELINE_TOKEN=
GUARDIAN_VERDICT_WAIT_S=4
TRUST_THRESHOLD=0.7
# --- Security / storage ---
BRAIN_SIGNING_KEY=             # empty = generated once in $BRAIN_DATA_DIR/secrets/brain_signing.key
BRAIN_DATA_DIR=data            # offline vault, decision journal, key
OFFLINE_DECISION_TTL_S=300
LOG_LEVEL=INFO
